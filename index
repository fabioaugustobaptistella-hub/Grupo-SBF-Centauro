<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>iungo · Proposta Executiva Centauro</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{background:#050816;font-family:'Inter',sans-serif;overflow:hidden;}
h1,h2,h3{color:#F5F7FB;}
h1{font-weight:900;letter-spacing:-.03em;line-height:1.08;}
h2{font-weight:800;letter-spacing:-.025em;line-height:1.12;}
h3{font-weight:700;letter-spacing:-.015em;}
p,span,li{font-weight:400;line-height:1.6;color:#AAB3C5;}

.presentation{width:100vw;height:100vh;overflow:hidden;position:relative;}
.slides{display:flex;height:100%;transition:transform .7s cubic-bezier(.22,1,.36,1);}
.slide{
  width:100vw;height:100vh;flex-shrink:0;position:relative;
  display:flex;align-items:center;justify-content:center;
  padding:60px 80px;
}
.slide::before{
  content:'';position:absolute;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(900px 420px at 72% 18%, rgba(255,120,180,.14) 0%, transparent 42%),
    radial-gradient(800px 380px at 35% 20%, rgba(35,110,255,.14) 0%, transparent 42%),
    linear-gradient(180deg, #0A0F24 0%, #070B1D 45%, #050816 100%);
}
.slide::after{
  content:'';position:absolute;inset:0;z-index:0;pointer-events:none;opacity:.3;
  background-image:radial-gradient(rgba(255,255,255,.06) .8px, transparent .8px);
  background-size:24px 24px;
}
.slide>*{position:relative;z-index:1;}

.gt{
  background:linear-gradient(135deg,#2E6BFF 0%,#C86DD7 50%,#2E6BFF 100%);
  background-size:200% auto;
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  animation:shimmer 4s linear infinite;
}
@keyframes shimmer{0%{background-position:-200% center}100%{background-position:200% center}}

.gl{width:90px;height:4px;border-radius:2px;background:linear-gradient(90deg,#2E6BFF,#C86DD7);margin-bottom:22px;animation:lineG .8s ease both;transform-origin:left;}
.gl.ce{margin:0 auto 22px auto;transform-origin:center;}
@keyframes lineG{from{transform:scaleX(0)}to{transform:scaleX(1)}}

.card{
  background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);
  border-radius:22px;box-shadow:0 16px 48px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.04);
  padding:32px 28px;backdrop-filter:blur(8px);transition:all .4s ease;
}
.card:hover{border-color:rgba(46,107,255,.2);transform:translateY(-3px);box-shadow:0 24px 60px rgba(0,0,0,.5),0 0 30px rgba(46,107,255,.08);}

.cp{
  background:linear-gradient(145deg, rgba(18,11,43,.95) 0%, rgba(10,15,36,.98) 55%, rgba(5,8,22,1) 100%);
  border:1px solid rgba(255,255,255,.08);border-radius:22px;
  box-shadow:0 20px 50px rgba(0,0,0,.45),0 0 40px rgba(46,107,255,.08);
  padding:34px 30px;backdrop-filter:blur(10px);transition:all .4s ease;
}
.cp:hover{border-color:rgba(46,107,255,.25);transform:translateY(-3px) scale(1.01);box-shadow:0 28px 64px rgba(0,0,0,.55),0 0 50px rgba(46,107,255,.12);}

.badge{
  display:inline-flex;align-items:center;gap:10px;padding:10px 24px;border-radius:999px;margin-bottom:32px;
  background:rgba(46,107,255,.08);border:1px solid rgba(46,107,255,.2);
  font-size:14px;font-weight:600;color:#8FAEFF;letter-spacing:.05em;text-transform:uppercase;
}

.tn{
  width:72px;height:72px;border-radius:18px;margin:0 auto 20px;display:flex;align-items:center;justify-content:center;
  font-size:24px;font-weight:900;color:#fff;animation:glowP 3s ease-in-out infinite;flex-shrink:0;
}
.tn.n1{background:linear-gradient(145deg,#2E6BFF,#1E56D9);}
.tn.n2{background:linear-gradient(145deg,#5B3FD6,#4530B3);animation-delay:.5s;}
.tn.n3{background:linear-gradient(145deg,#C86DD7,#A854BF);animation-delay:1s;}
.tn.n4{background:linear-gradient(145deg,#2E6BFF,#5B3FD6);animation-delay:1.5s;}
@keyframes glowP{0%,100%{box-shadow:0 0 18px rgba(46,107,255,.12)}50%{box-shadow:0 0 36px rgba(46,107,255,.3)}}

.ic{width:54px;height:54px;border-radius:14px;margin-bottom:18px;display:flex;align-items:center;justify-content:center;background:rgba(46,107,255,.08);}
.ic svg{width:26px;height:26px;color:#2E6BFF;}

.s5c{position:relative;overflow:hidden;}
.s5c::before{content:'';position:absolute;top:0;left:0;width:5px;height:100%;border-radius:2px 0 0 2px;}

.s5n{font-size:52px;font-weight:900;letter-spacing:-.03em;line-height:1.1;margin-bottom:8px;}

.fl{display:flex;align-items:center;justify-content:center;gap:0;flex-wrap:wrap;}
.fs{display:flex;flex-direction:column;align-items:center;text-align:center;min-width:140px;padding:0 8px;}
.fs .fi{width:76px;height:76px;border-radius:20px;background:rgba(46,107,255,.08);border:1px solid rgba(46,107,255,.18);display:flex;align-items:center;justify-content:center;margin-bottom:14px;}
.fs .fi svg{width:34px;height:34px;color:#2E6BFF;}
.fs span{font-size:14px;font-weight:600;color:#F5F7FB;}
.fa{display:flex;align-items:center;padding-bottom:30px;margin:0 6px;}
.fa svg{width:26px;height:26px;color:#7E879B;}
.fs.act .fi{background:linear-gradient(180deg,#2E6BFF,#1E56D9);border-color:transparent;box-shadow:0 10px 22px rgba(46,107,255,.28);}
.fs.act .fi svg{color:#fff;}

@keyframes fadeUp{from{opacity:0;transform:translateY(35px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeScale{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:scale(1)}}
.slide.active .au{animation:fadeUp .7s ease both;}
.slide.active .as{animation:fadeScale .7s ease both;}
.d1{animation-delay:.1s !important}
.d2{animation-delay:.22s !important}
.d3{animation-delay:.34s !important}
.d4{animation-delay:.46s !important}
.d5{animation-delay:.58s !important}
.d6{animation-delay:.7s !important}
.d7{animation-delay:.82s !important}

/* Slide 1 */
.s1{text-align:center;max-width:1000px;margin:0 auto;}
.s1 h1{font-size:clamp(48px,6.5vw,78px);margin-bottom:22px;}
.s1 .tag{font-size:20px;color:#AAB3C5;max-width:640px;margin:0 auto 26px auto;line-height:1.5;}
.s1 .sub{font-size:14px;color:#7E879B;letter-spacing:.03em;margin-top:20px;}
.s1 .prep{font-size:13px;color:#7E879B;margin-top:36px;letter-spacing:.02em;}

.wrap{width:100%;max-width:1180px;margin:0 auto;}
.stitle{font-size:clamp(32px,4vw,46px);margin-bottom:14px;}
.slabel{font-size:14px;color:#7E879B;text-transform:uppercase;letter-spacing:.08em;font-weight:700;margin-bottom:10px;}

/* Slide 2 */
.hero-num{font-size:44px;font-weight:900;color:#F5F7FB;margin-bottom:6px;}
.hero-num span{background:linear-gradient(135deg,#2E6BFF,#C86DD7);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}

/* Slide 3 grid */
.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-bottom:34px;}
.metric-card{text-align:center;padding:26px 14px;}
.metric-card .s5n{font-size:44px;}
.metric-card p{font-size:13px;color:#AAB3C5;margin-top:4px;}
.trig-row{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:22px;}
.trig{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:999px;padding:8px 16px;font-size:12px;color:#AAB3C5;}
.clients{font-size:12px;color:#7E879B;text-align:center;letter-spacing:.02em;}

/* Slide 4 */
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
.grid3 .cp h3{font-size:19px;margin-bottom:10px;}
.grid3 .cp p{font-size:13.5px;margin-bottom:14px;}
.proj{font-size:15px;font-weight:800;color:#5EE89A;}

/* Slide 5 */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:26px;}
.col-title{font-size:20px;margin-bottom:18px;}
.bullet-list{list-style:none;}
.bullet-list li{position:relative;padding-left:22px;margin-bottom:12px;font-size:14.5px;}
.bullet-list li::before{content:'';position:absolute;left:0;top:8px;width:6px;height:6px;border-radius:50%;background:#2E6BFF;}
.col-right .bullet-list li::before{background:#C86DD7;}

/* Slide 6 timeline */
.timeline{display:flex;flex-direction:column;gap:22px;max-width:820px;margin:0 auto;}
.tstep{display:flex;align-items:flex-start;gap:22px;}
.tstep h3{font-size:17px;margin-bottom:4px;}
.tstep p{font-size:14px;}

/* Slide 7 */
.s7{text-align:center;max-width:760px;margin:0 auto;}
.s7 h2{font-size:clamp(30px,4vw,42px);margin-bottom:20px;}
.contact-card{margin-top:34px;display:inline-block;text-align:left;}
.contact-card p{font-size:15px;margin-bottom:6px;}
.contact-card .name{font-size:18px;font-weight:800;color:#F5F7FB;margin-bottom:4px;}
.conf{margin-top:40px;font-size:12px;color:#7E879B;letter-spacing:.02em;}

/* Chrome */
.progress{position:fixed;top:0;left:0;height:3px;z-index:1000;background:linear-gradient(90deg,#2E6BFF,#C86DD7,#2E6BFF);background-size:200% auto;animation:shimmer 3s linear infinite;transition:width .6s ease;}
.fs-btn{position:fixed;top:20px;right:20px;z-index:999;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);color:#7E879B;padding:12px 18px;border-radius:12px;cursor:pointer;font-family:'Inter',sans-serif;font-size:12px;font-weight:600;display:flex;align-items:center;gap:8px;transition:all .3s ease;backdrop-filter:blur(6px);letter-spacing:.04em;text-transform:uppercase;}
.fs-btn:hover{background:rgba(255,255,255,.08);color:#F5F7FB;border-color:rgba(46,107,255,.3);}
.fs-btn svg{width:16px;height:16px;}
.sc{position:fixed;bottom:36px;left:40px;z-index:998;color:#7E879B;font-size:14px;font-weight:600;letter-spacing:.05em;background:rgba(0,0,0,.3);padding:10px 18px;border-radius:10px;backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.05);}
.sc .cn{color:#2E6BFF;font-weight:800;}
.ind{position:fixed;bottom:36px;left:50%;transform:translateX(-50%);z-index:998;display:flex;gap:7px;background:rgba(0,0,0,.3);padding:10px 16px;border-radius:20px;backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.05);}
.ind .dot{width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,.15);transition:all .4s ease;cursor:pointer;}
.ind .dot.active{background:#2E6BFF;box-shadow:0 0 14px rgba(46,107,255,.6);width:34px;border-radius:5px;}
.nav-arr{position:fixed;bottom:32px;right:40px;z-index:998;display:flex;gap:10px;}
.nav-arr button{width:52px;height:52px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:#AAB3C5;font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .3s ease;backdrop-filter:blur(6px);}
.nav-arr button:hover{background:rgba(46,107,255,.2);border-color:rgba(46,107,255,.4);color:#fff;transform:scale(1.05);}

@media(max-width:900px){
  .slide{padding:40px 24px;}
  .metric-grid,.grid3,.grid2{grid-template-columns:1fr;}
  .fl{flex-direction:column;}
  .fa{transform:rotate(90deg);padding-bottom:0;margin:6px 0;}
}
</style>
</head>
